@using System.Data
@{
    DataTable tabela = ViewBag.Tabela as DataTable;
}
<div class="page-title">Spisak sorti za ažuriranje</div>
<table class="data-table" style="width:480px">
    <thead>
        <tr>
            <th></th>
            <th>Šifra</th>
            <th>Naziv</th>
        </tr>
    </thead>
    <tbody>
@if (tabela != null)
{
    foreach (DataRow red in tabela.Rows)
    {
        <tr>
            <td>@Html.ActionLink("Izaberi", "Detalji", "Sorta", new { Sifra = red["Sifra"] }, null)</td>
            <td>@red["Sifra"]</td>
            <td>@red["Naziv"]</td>
        </tr>
    }
}
    </tbody>
</table>
