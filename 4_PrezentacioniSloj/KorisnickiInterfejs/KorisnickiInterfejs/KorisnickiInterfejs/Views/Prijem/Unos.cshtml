@using System.Data
@model KorisnickiInterfejs.Models.PrijemUnosViewModel
@{
    DataTable stavke = ViewBag.Stavke as DataTable;
}
<div class="page-title">Master-detail unos prijema sa turama</div>
@using (Html.BeginForm("Unos", "Prijem", FormMethod.Post))
{
    <table class="form-table">
        <tr>
            <td>Broj prijema</td>
            <td>@Html.TextBoxFor(m => m.BrojPrijema, new { id = "BrojPrijemaTextBox", maxlength = "20" })</td>
        </tr>
        <tr>
            <td>Datum prijema</td>
            <td>@Html.TextBoxFor(m => m.DatumPrijema, new { id = "DatumPrijemaTextBox" })</td>
        </tr>
        <tr>
            <td>Isporučilac</td>
            <td>@Html.TextBoxFor(m => m.Isporucilac, new { id = "IsporucilacTextBox", style = "width:233px" })</td>
        </tr>
    </table>
    <div class="page-title">Stavka — tura</div>
    <table class="form-table">
        <tr>
            <td>Oznaka</td>
            <td>@Html.TextBoxFor(m => m.Oznaka, new { id = "OznakaTextBox", maxlength = "10" })</td>
        </tr>
        <tr>
            <td>Sorta</td>
            <td>@Html.DropDownListFor(m => m.NazivSorte, (IEnumerable<SelectListItem>)ViewBag.Sorte, new { id = "SortaDropDownList", style = "width:233px" })</td>
        </tr>
        <tr>
            <td>Neto masa (kg)</td>
            <td>@Html.TextBoxFor(m => m.NetoMasaKg, new { id = "NetoMasaKgTextBox" })</td>
        </tr>
        <tr>
            <td>Šećer (%)</td>
            <td>@Html.TextBoxFor(m => m.SecerProcenat, new { id = "SecerProcenatTextBox" })</td>
        </tr>
        <tr>
            <td>Kiselost (g/l)</td>
            <td>@Html.TextBoxFor(m => m.KiselostGl, new { id = "KiselostGlTextBox" })</td>
        </tr>
        <tr>
            <td>Temperatura (°C)</td>
            <td>@Html.TextBoxFor(m => m.TemperaturaC, new { id = "TemperaturaCTextBox" })</td>
        </tr>
        <tr>
            <td>Udeo oštećenih (%)</td>
            <td>@Html.TextBoxFor(m => m.UdeoOstecenihProcenat, new { id = "UdeoOstecenihProcenatTextBox" })</td>
        </tr>
        <tr>
            <td></td>
            <td>
                <button type="submit" name="akcija" value="dodaj" onclick="return ProveriStavkuTure();">DODAJ TURU</button>
            </td>
        </tr>
    </table>
    <table class="data-table" style="width:100%">
        <thead>
            <tr>
                <th>Oznaka</th>
                <th>Sorta</th>
                <th>Neto (kg)</th>
                <th>Šećer (%)</th>
                <th>Kiselost</th>
                <th>t (°C)</th>
                <th>Oštećene (%)</th>
            </tr>
        </thead>
        <tbody>
@if (stavke != null)
{
    foreach (DataRow red in stavke.Rows)
    {
            <tr>
                <td>@red["Oznaka"]</td>
                <td>@red["NazivSorte"]</td>
                <td>@red["NetoMasaKg"]</td>
                <td>@red["SecerProcenat"]</td>
                <td>@red["KiselostGl"]</td>
                <td>@red["TemperaturaC"]</td>
                <td>@red["UdeoOstecenihProcenat"]</td>
            </tr>
    }
}
        </tbody>
    </table>
    <span class="status-label">@Model.Poruka</span>
    <button type="submit" name="akcija" value="snimi" onclick="return ProveriZaglavljePrijema();">SNIMI SVE (transakcija)</button>
    <button type="submit" name="akcija" value="ponisti">PONISTI</button>
}
